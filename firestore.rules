rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    function hasActiveRestriction(uid) {
      return exists(/databases/$(database)/documents/accountRestrictions/$(uid))
        && get(/databases/$(database)/documents/accountRestrictions/$(uid)).data.active == true
        && (
          get(/databases/$(database)/documents/accountRestrictions/$(uid)).data.expiresAt == null
          || get(/databases/$(database)/documents/accountRestrictions/$(uid)).data.expiresAt > request.time
        );
    }

    function canCreateCommunityPost() {
      return !hasActiveRestriction(request.auth.uid)
        || get(/databases/$(database)/documents/accountRestrictions/$(request.auth.uid)).data.mode == 'comment';
    }

    function canCreateComment() {
      return !hasActiveRestriction(request.auth.uid)
        || get(/databases/$(database)/documents/accountRestrictions/$(request.auth.uid)).data.mode == 'post';
    }

    match /communityProfiles/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'username', 'photoURL', 'verified', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && (request.resource.data.photoURL is string || request.resource.data.photoURL == null)
        && request.resource.data.verified == false
        && getAfter(/databases/$(database)/documents/communityUsernames/$(request.resource.data.username)).data.uid == uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoURL', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /communityUsernames/{username} {
      allow read: if true;
      allow create: if (isAdmin() || (request.auth != null && request.resource.data.uid == request.auth.uid))
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid is string
        && request.resource.data.username == username
        && username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.createdAt is timestamp
        && getAfter(/databases/$(database)/documents/communityProfiles/$(request.resource.data.uid)).data.username == username;
      allow update, delete: if isAdmin();
    }

    match /restrictionAppeals/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/restrictionAppeals/$(uid))
        && request.resource.data.keys().hasOnly(['uid', 'email', 'reason', 'mode', 'message', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'reason', 'mode', 'message', 'status', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.reason is string
        && request.resource.data.mode == 'full'
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1500
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp;
      allow update: if (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decisionNote', 'reviewedBy', 'reviewedAt'])
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
        ) || (
          request.auth != null && request.auth.uid == uid
          && resource.data.status == 'rejected'
          && request.resource.data.uid == uid
          && request.resource.data.mode == 'full'
          && request.resource.data.status == 'pending'
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 1500
          && request.resource.data.createdAt is timestamp
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['message', 'status', 'createdAt', 'decisionNote', 'reviewedBy', 'reviewedAt'])
        );
      allow delete: if isAdmin();
    }

    match /accountRestrictions/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update, delete: if isAdmin();
    }

    // Administrators may create and read immutable moderation audit entries.
    // Students cannot write to this collection, and no client can alter old logs.
    match /moderationLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['actorEmail', 'action', 'targetUid', 'reason', 'mode', 'expiresAt', 'createdAt'])
        && request.resource.data.keys().hasAll(['actorEmail', 'action', 'targetUid', 'createdAt'])
        && request.resource.data.actorEmail is string
        && request.resource.data.action is string
        && request.resource.data.targetUid is string
        && (!('reason' in request.resource.data) || request.resource.data.reason is string)
        && (!('mode' in request.resource.data) || request.resource.data.mode is string)
        && (!('expiresAt' in request.resource.data) || request.resource.data.expiresAt == null || request.resource.data.expiresAt is timestamp)
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /interviews/{interviewId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /posts/{postId}/likes/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
    }

    match /communityPosts/{postId}/likes/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && exists(/databases/$(database)/documents/communityPosts/$(postId))
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.createdAt is timestamp;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
    }

    match /communityPosts/{postId}/reports/{reportId} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['reporterUid', 'reason', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['reporterUid', 'reason', 'status', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'open'
        && request.resource.data.status == 'reviewed';
      allow delete: if isAdmin();
    }

    match /communityPosts/{postId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create: if request.auth != null
        && canCreateCommunityPost()
        && exists(/databases/$(database)/documents/communityProfiles/$(request.auth.uid))
        && request.resource.data.authorName == get(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data.displayName
        && request.resource.data.authorPhotoURL == get(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data.photoURL
        && request.resource.data.keys().hasOnly(['text', 'authorUid', 'authorName', 'authorPhotoURL', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['text', 'authorUid', 'authorName', 'authorPhotoURL', 'status', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 100
        && (request.resource.data.authorPhotoURL == null || request.resource.data.authorPhotoURL is string)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 280
        && request.resource.data.status == 'published'
        && request.resource.data.createdAt is timestamp;
      allow delete: if request.auth != null && (resource.data.authorUid == request.auth.uid || isAdmin());
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['published', 'hidden'])
        || (request.auth != null
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 280
          && request.resource.data.editedAt is timestamp);

      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/communityPosts/$(postId)).data.status == 'published' || isAdmin();
        allow create: if request.auth != null && canCreateComment()
          && exists(/databases/$(database)/documents/communityProfiles/$(request.auth.uid))
          && request.resource.data.keys().hasOnly(['text', 'authorUid', 'authorName', 'authorPhotoURL', 'parentId', 'createdAt'])
          && request.resource.data.keys().hasAll(['text', 'authorUid', 'authorName', 'authorPhotoURL', 'parentId', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName == get(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data.displayName
          && request.resource.data.authorPhotoURL == get(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data.photoURL
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && (request.resource.data.parentId == null
            || (request.resource.data.parentId is string
              && exists(/databases/$(database)/documents/communityPosts/$(postId)/comments/$(request.resource.data.parentId))));
        allow update: if request.auth != null && resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow delete: if request.auth != null && (resource.data.authorUid == request.auth.uid || isAdmin());

        match /likes/{uid} {
          allow read: if true;
          allow create: if request.auth != null && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
            && request.resource.data.uid == uid && request.resource.data.createdAt is timestamp;
          allow delete: if request.auth != null && request.auth.uid == uid;
          allow update: if false;
        }
      }
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dailyViews/{viewId} {
      allow read: if true;
      allow create, update: if request.resource.data.postId is string
        && request.resource.data.date is string
        && request.resource.data.views is number;
      allow delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && canCreateComment()
        && request.resource.data.keys().hasOnly(['postId', 'postSlug', 'postTitle', 'authorUid', 'authorName', 'authorPhotoURL', 'text', 'createdAt', 'parentId'])
        && request.resource.data.keys().hasAll(['postId', 'postSlug', 'postTitle', 'authorUid', 'authorName', 'authorPhotoURL', 'text', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string && request.resource.data.authorName.size() > 0 && request.resource.data.authorName.size() <= 100
        && (request.resource.data.authorPhotoURL == null || request.resource.data.authorPhotoURL is string)
        && request.resource.data.postId is string && request.resource.data.postSlug is string && request.resource.data.postTitle is string
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt is timestamp
        && (!('parentId' in request.resource.data) || request.resource.data.parentId == null
          || (request.resource.data.parentId is string && exists(/databases/$(database)/documents/comments/$(request.resource.data.parentId))
            && get(/databases/$(database)/documents/comments/$(request.resource.data.parentId)).data.postId == request.resource.data.postId));
      allow delete: if request.auth != null && (resource.data.authorUid == request.auth.uid || isAdmin());
      allow update: if request.auth != null && resource.data.authorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000 && request.resource.data.editedAt is timestamp;
    }

    match /comments/{commentId}/likes/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == uid && request.resource.data.createdAt is timestamp;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
    }
  }
}
