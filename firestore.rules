    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dailyViews/{viewId} {
      allow read: if true;
      allow create, update: if request.resource.data.postId is string
        && request.resource.data.date is string
        && request.resource.data.views is number;
      allow delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;

      allow create: if request.auth != null
                     && canCreateComment()
                     && request.resource.data.keys().hasOnly([
                       'postId', 'postSlug', 'postTitle', 'authorUid',
                       'authorName', 'authorPhotoURL', 'text', 'createdAt'
                     ])
                     && request.resource.data.keys().hasAll([
                       'postId', 'postSlug', 'postTitle', 'authorUid',
                       'authorName', 'authorPhotoURL', 'text', 'createdAt'
                     ])
                     && request.resource.data.authorUid == request.auth.uid
                     && request.resource.data.authorName is string
                     && request.resource.data.authorName.size() > 0
                     && request.resource.data.authorName.size() <= 100
                     && (request.resource.data.authorPhotoURL == null
                       || request.resource.data.authorPhotoURL is string)
                     && request.resource.data.postId is string
                     && request.resource.data.postSlug is string
                     && request.resource.data.postTitle is string
                     && request.resource.data.text is string
                     && request.resource.data.text.size() > 0
                     && request.resource.data.text.size() <= 1000
