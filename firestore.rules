rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    function hasActiveRestriction(uid) {
      return exists(/databases/$(database)/documents/accountRestrictions/$(uid))
        && get(/databases/$(database)/documents/accountRestrictions/$(uid)).data.active == true
        && (
          get(/databases/$(database)/documents/accountRestrictions/$(uid)).data.expiresAt == null
          || get(/databases/$(database)/documents/accountRestrictions/$(uid)).data.expiresAt > request.time
        );
    }

    function canCreateCommunityPost() {
      return !hasActiveRestriction(request.auth.uid)
        || get(/databases/$(database)/documents/accountRestrictions/$(request.auth.uid)).data.mode == 'comment';
    }

    function canCreateComment() {
      return !hasActiveRestriction(request.auth.uid)
        || get(/databases/$(database)/documents/accountRestrictions/$(request.auth.uid)).data.mode == 'post';
    }

    match /accountRestrictions/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update, delete: if isAdmin();
    }

    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /interviews/{interviewId} {
      // Visitors can only read published interviews. Admins can manage drafts too.
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /posts/{postId} {
      // Public users can only read posts marked as published.
      // The application additionally filters out posts whose
      // publishAt date has not yet arrived.
      allow read: if resource.data.status == 'published' || isAdmin();

      // Admins can manage all posts.
      allow create, update, delete: if isAdmin();
    }

    match /posts/{postId}/likes/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
    }

    match /communityPosts/{postId} {
      // Community posts are public to read once published.
      allow read: if resource.data.status == 'published' || isAdmin();

      // Readers must be signed in with the same Google/Firebase account used
      // for article comments and likes. Posts are text-only and limited to 280 chars.
      allow create: if request.auth != null
        && canCreateCommunityPost()
        && request.resource.data.keys().hasOnly([
          'text', 'authorUid', 'authorName', 'authorPhotoURL', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'text', 'authorUid', 'authorName', 'authorPhotoURL', 'status', 'createdAt'
        ])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 100
        && (request.resource.data.authorPhotoURL == null
          || request.resource.data.authorPhotoURL is string)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 280
        && request.resource.data.status == 'published'
        && request.resource.data.createdAt is timestamp;

      allow delete: if request.auth != null
        && (resource.data.authorUid == request.auth.uid || isAdmin());

      // Only administrators may change moderation status. Authors cannot
      // rewrite identity, timestamps or content after publication.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['published', 'hidden'];
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dailyViews/{viewId} {
      allow read: if true;
      allow create, update: if request.resource.data.postId is string
        && request.resource.data.date is string
        && request.resource.data.views is number;
      allow delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;

      allow create: if request.auth != null
                     && canCreateComment()
                     && request.resource.data.authorUid == request.auth.uid
                     && request.resource.data.text is string
                     && request.resource.data.text.size() > 0
                     && request.resource.data.text.size() <= 1000;

      allow delete: if request.auth != null
                     && (
                       resource.data.authorUid == request.auth.uid
                       || isAdmin()
                     );

      allow update: if false;
    }
  }
}